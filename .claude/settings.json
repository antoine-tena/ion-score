{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ION_REPO_PROJECT": "ion-score",
    "ION_REPO_BACKEND_DIR": "backend",
    "ION_REPO_FRONTEND_DIR": "",
    "ION_REPO_TEST_ENV": ""
  },
  "autoCompactWindow": 400000,
  "plansDirectory": ".claude/plans",
  "extraKnownMarketplaces": {
    "ion-repo": {
      "source": {
        "source": "github",
        "repo": "antoine-tena/ion-repo",
        "ref": "main"
      },
      "autoUpdate": true
    },
    "ion-score": {
      "source": {
        "source": "github",
        "repo": "antoine-tena/ion-score",
        "ref": "main"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "repo@ion-repo": true,
    "score@ion-score": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)"
    ]
  }
}
